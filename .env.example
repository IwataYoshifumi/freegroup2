DJANGO_SECRET_KEY=
DEBUG=True
ANTHROPIC_API_KEY=
OCR_BACKEND=claude_sonnet_4_6
CARD_DETECTOR_BACKEND=opencv

# メール本文に埋め込むリンクのベースURL（スキーム+ホスト+ポート、末尾スラッシュなし）。
# トラッキング {MAILING_SITE_URL}/t/<token>/・配信停止 {MAILING_SITE_URL}/u/ 等に使用。
# 未設定時は http://localhost:8000 にフォールバック。検証用の実ホストは各自の .env に設定。
MAILING_SITE_URL=http://localhost:8000

# 認証バックエンド切替（local / ldap / both）
AUTH_BACKEND=local

# LDAP 接続情報（AUTH_BACKEND=ldap / both のときのみ使用）
LDAP_SERVER_URI=ldap://ldap.example.com:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=ou=People,dc=example,dc=com
LDAP_GROUP_SEARCH_BASE=ou=Groups,dc=example,dc=com
LDAP_USER_USERNAME_ATTR=sAMAccountName
LDAP_CACHE_ENABLED=true
LDAP_CACHE_TTL=3600
