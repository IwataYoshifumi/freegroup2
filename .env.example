DJANGO_SECRET_KEY=
DEBUG=True
ANTHROPIC_API_KEY=
# OCR 実行バックエンド切替：
#   claude_sonnet_4_6 … Claude API で OCR（既定。"_"→"-" 変換で claude-sonnet-4-6 を使用）
#   worker_cowork     … media/ocr_json/{original_image_id}-{card_index}.json を読み取る
#                       （ファイル未着の BC は pending 維持、スキーマ違反は ocr_failed）
OCR_BACKEND=claude_sonnet_4_6
CARD_DETECTOR_BACKEND=opencv

# 名刺向き正位化バックエンド（PP-LCNet / OSD / none）。既定 PP-LCNet。
ORIENTATION_BACKEND=PP-LCNet
# 向き判定スコア閾値（PP-LCNet softmax 確率、これ未満は据え置き）。既定 0.7。
ORIENTATION_SCORE_THRESHOLD=0.7

# メール本文に埋め込むリンクのベースURL（スキーム+ホスト+ポート、末尾スラッシュなし）。
# トラッキング {MAILING_SITE_URL}/t/<token>/・配信停止 {MAILING_SITE_URL}/u/ 等に使用。
# 未設定時は http://localhost:8000 にフォールバック。検証用の実ホストは各自の .env に設定。
MAILING_SITE_URL=http://localhost:8000

# --- データベース ---
# DB_ENGINE=postgresql のとき PostgreSQL に接続する。未設定 / sqlite のときは
# 従来どおり BASE_DIR/db.sqlite3 の SQLite を使用する（ローカル開発はこのままでよい）。
DB_ENGINE=postgresql
DB_NAME=freegroup2
DB_USER=freegroup2
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- 認証バックエンド ---
# 本番（自宅サーバ）は LDAP 未使用のため local 固定。
AUTH_BACKEND=local

# LDAP 接続情報（AUTH_BACKEND=ldap / both のときのみ使用）
LDAP_SERVER_URI=ldap://ldap.example.com:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=ou=People,dc=example,dc=com
LDAP_GROUP_SEARCH_BASE=ou=Groups,dc=example,dc=com
LDAP_USER_USERNAME_ATTR=sAMAccountName
LDAP_CACHE_ENABLED=true
LDAP_CACHE_TTL=3600

# --- メール送信 ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
# EMAIL_USE_TLS と EMAIL_USE_SSL を同時 True にしない（Django 起動時エラー）。587 運用なら TLS=True / SSL=False。
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- バウンスメール受信（IMAP） ---
# 自社 SMTP 方式のバウンス取り込み・Return-Path（エンベロープ送信者）用設定
BOUNCE_INBOX_HOST=
BOUNCE_INBOX_PORT=993
BOUNCE_INBOX_USER=
BOUNCE_INBOX_PASSWORD=
BOUNCE_INBOX_USE_SSL=True

