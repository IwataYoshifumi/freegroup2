DJANGO_SECRET_KEY=
DEBUG=True
ANTHROPIC_API_KEY=
OCR_BACKEND=claude_sonnet_4_6
CARD_DETECTOR_BACKEND=opencv
# Tesseract OSD（名刺クロップの正立化・rev2 第2部）
# TESSERACT_CMD: tesseract 実行ファイルのパス。PATH が通っていれば空のままでよい（既定で PATH の tesseract を使う）。
#   PATH を通さない場合のみフルパスを指定（例 Windows: C:\Program Files\Tesseract-OCR\tesseract.exe）。
TESSERACT_CMD=
# OSD_TIMEOUT_SEC: image_to_osd のタイムアウト秒（既定 10）。
OSD_TIMEOUT_SEC=10
