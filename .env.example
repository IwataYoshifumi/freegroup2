DJANGO_SECRET_KEY=
DEBUG=True

# 許可ホスト（カンマ区切り）。未設定時はソースコード内にハードコードされた
# LAN内IPアドレスのリストにフォールバックする（settings.py参照）。
# 本番でハードコード外のホスト名・IPを使う場合は必ず設定すること。
ALLOWED_HOSTS=

# CSRFを許可するオリジン（スキーム付き、カンマ区切り）。nginx等でSSL終端して
# Djangoへプロキシする構成で使用。未設定時はソースコード内にハードコードされた
# LAN内IPアドレスのリストにフォールバックする（settings.py参照）。
# 例：CSRF_TRUSTED_ORIGINS=https://your-domain.example.com,https://192.0.2.1
CSRF_TRUSTED_ORIGINS=

ANTHROPIC_API_KEY=
# OCR 実行バックエンド切替：
#   claude_sonnet_4_6 … Claude API で OCR（既定。"_"→"-" 変換で claude-sonnet-4-6 を使用）
#   worker_cowork     … media/ocr_json/{original_image_id}-{card_index}.json を読み取る
#                       （ファイル未着の BC は pending 維持、スキーマ違反は ocr_failed）
OCR_BACKEND=claude_sonnet_4_6
CARD_DETECTOR_BACKEND=opencv

# 名刺向き正位化バックエンド（PP-LCNet / OSD / none）。既定 PP-LCNet。
ORIENTATION_BACKEND=PP-LCNet
# 向き判定スコア閾値（PP-LCNet softmax 確率、これ未満は据え置き）。既定 0.7。
ORIENTATION_SCORE_THRESHOLD=0.7

# メール本文に埋め込むリンクのベースURL（スキーム+ホスト+ポート、末尾スラッシュなし）。
# トラッキング {MAILING_SITE_URL}/t/<token>/・配信停止 {MAILING_SITE_URL}/u/ 等に使用。
# 未設定時は http://localhost:8000 にフォールバック。検証用の実ホストは各自の .env に設定。
MAILING_SITE_URL=http://localhost:8000

# --- データベース ---
# DB_ENGINE=postgresql のとき PostgreSQL に接続する。未設定 / sqlite のときは
# 従来どおり BASE_DIR/db.sqlite3 の SQLite を使用する（ローカル開発はこのままでよい）。
DB_ENGINE=postgresql
DB_NAME=freegroup2
DB_USER=freegroup2
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- 認証バックエンド ---
# 本番（自宅サーバ）は LDAP 未使用のため local 固定。
AUTH_BACKEND=local

# LDAP 接続情報（AUTH_BACKEND=ldap / both のときのみ使用）
LDAP_SERVER_URI=ldap://ldap.example.com:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=ou=People,dc=example,dc=com
LDAP_GROUP_SEARCH_BASE=ou=Groups,dc=example,dc=com
LDAP_USER_USERNAME_ATTR=sAMAccountName
LDAP_CACHE_ENABLED=true
LDAP_CACHE_TTL=3600

# --- メール送信 ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
# EMAIL_USE_TLS と EMAIL_USE_SSL を同時 True にしない（Django 起動時エラー）。587 運用なら TLS=True / SSL=False。
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- バウンスメール受信（IMAP） ---
# 自社 SMTP 方式のバウンス取り込み・Return-Path（エンベロープ送信者）用設定
BOUNCE_INBOX_HOST=
BOUNCE_INBOX_PORT=993
BOUNCE_INBOX_USER=
BOUNCE_INBOX_PASSWORD=
BOUNCE_INBOX_USE_SSL=True

# コンタクトのデフォルト国コード（ISO 3166-1 alpha-2）。CSVインポートの country 未入力時、
# および手動作成フォームの country 初期値に使用。
DEFAULT_CONTACT_COUNTRY=JP

# --- ロギング ---
# ログ詳細度（通常運用 INFO / 一時デバッグ DEBUG）。既定 INFO。
# DEBUG にするとサーバー側のログ（docker compose logs -f web 等）に詳細出力されるが、
# Django の DEBUG モード（画面にトレースバックを表示）とは別物で、本番でも安全に使える。
# 問題解決後は INFO に戻すこと。
LOG_LEVEL=INFO

# --- ログインセキュリティ強化（二段階認証・IP取得・鍵入れ替え） ---
# 認証アプリ（TOTP）に表示される発行者名。既定 FreeGroup2。
OTP_TOTP_ISSUER=FreeGroup2

# 端末識別クッキーの名前（同一ホスト別ポートで複数環境を動かす場合に重複を防ぐ）。既定 freegroup2_device_8000。
DEVICE_COOKIE_NAME=freegroup2_device_8000

# 接続元 IP アドレスの取得元（x_real_ip / remote_addr）。既定 x_real_ip。
# Docker + nginx 構成では x_real_ip を使用し、nginx を通さない Windows ローカル開発などでは remote_addr にする。
CLIENT_IP_SOURCE=x_real_ip

# 旧秘密鍵の一覧（カンマ区切り）。既定は空。
# 鍵の入れ替え手順：
#   1. 現在の DJANGO_SECRET_KEY の値を SECRET_KEY_FALLBACKS に移し、DJANGO_SECRET_KEY を新しい鍵に差し替えて再起動する。
#   2. 旧鍵を設定すると、入れ替え前のセッションも有効なまま残る（全員がログアウトされないための Django 標準の動き）。
#   3. 旧鍵を残している間は、旧鍵で発行したリカバリーコードも使える。旧鍵を外すと、そのコードは無効になる（再発行を案内する）。
#   4. 十分な移行期間（セッション有効期間やリカバリーコード再発行の案内後）が過ぎたら、SECRET_KEY_FALLBACKS を空に戻す。
SECRET_KEY_FALLBACKS=

